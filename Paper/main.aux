\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Decorrelation in the 16D Solvated Periodic Grid. Top: PT reference samples exhibit spurious diagonal correlations. Bottom: Jeffreys Flow successfully uncouples the bath to recover the exact independent checkerboard structure.}}{19}{figure.7}\protected@file@percent }
\newlabel{fig: sl_joint}{{7}{19}{Decorrelation in the 16D Solvated Periodic Grid. Top: PT reference samples exhibit spurious diagonal correlations. Bottom: Jeffreys Flow successfully uncouples the bath to recover the exact independent checkerboard structure}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Potential of Mean Force (PMF) along $x_1$. Jeffreys Flow perfectly reconstructs the analytical free energy barriers that PT completely fails to cross.}}{20}{figure.8}\protected@file@percent }
\newlabel{fig: sl_pmf}{{8}{20}{Potential of Mean Force (PMF) along $x_1$. Jeffreys Flow perfectly reconstructs the analytical free energy barriers that PT completely fails to cross}{figure.8}{}}

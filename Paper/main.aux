\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Density plots of the generated samples across four 2D landscapes. The Jeffreys Flow ($0 < \theta < 1$) robustly corrects the noisy artifacts of Forward KL ($\theta =0$) and strictly prevents the destructive mode collapse inherent to Reverse KL ($\theta =1$).}}{16}{figure.2}\protected@file@percent }
\newlabel{fig: single_step}{{2}{16}{Density plots of the generated samples across four 2D landscapes. The Jeffreys Flow ($0 < \theta < 1$) robustly corrects the noisy artifacts of Forward KL ($\theta =0$) and strictly prevents the destructive mode collapse inherent to Reverse KL ($\theta =1$)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: The generated distribution from the Jeffreys Flow. The scatter samples accurately capture all modes of the periodic potential ($N=4^{12}$). Right: As sample size $N$ increases, the ESS remains consistently optimal ($\approx 100\%$) while the $L^2$ bias strictly follows the theoretical Monte Carlo convergence rate.}}{17}{figure.3}\protected@file@percent }
\newlabel{fig: single_step_periodic}{{3}{17}{Left: The generated distribution from the Jeffreys Flow. The scatter samples accurately capture all modes of the periodic potential ($N=4^{12}$). Right: As sample size $N$ increases, the ESS remains consistently optimal ($\approx 100\%$) while the $L^2$ bias strictly follows the theoretical Monte Carlo convergence rate}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Sequential distillation on the 3D Gaussian Mixture Model. Top: Reference PT samples at various temperatures. Bottom: Generated samples from the distilled Jeffreys Flow. The resulting bias of the Jeffreys Flow is much smaller than PT.}}{17}{figure.4}\protected@file@percent }
\newlabel{fig: gm_results}{{4}{17}{Sequential distillation on the 3D Gaussian Mixture Model. Top: Reference PT samples at various temperatures. Bottom: Generated samples from the distilled Jeffreys Flow. The resulting bias of the Jeffreys Flow is much smaller than PT}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sequential distillation on the 4D Rosenbrock. Top: Reference PT samples. Bottom: Generated samples from the Jeffreys Flow successfully learning the highly non-linear correlations.}}{18}{figure.5}\protected@file@percent }
\newlabel{fig: rb_results}{{5}{18}{Sequential distillation on the 4D Rosenbrock. Top: Reference PT samples. Bottom: Generated samples from the Jeffreys Flow successfully learning the highly non-linear correlations}{figure.5}{}}

\newlabel{tab: pimc_bias}{{V}{21}{Sampling Bias Evaluation in High Dimensions. Using solely a single transport map trained exclusively at the truncated dimension $N_0 = 8$, the reweighted Jeffreys Flow generates high-fidelity sampling accuracy uniformly up to $N = 32$, with the bias adhering to the rapid theoretical $\mathcal {O}(1/N^2)$ discretization error decay}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 2D Screened Poisson Equipment Setup. Left: The true multi-source distribution field generated by the ground truth locations. Right: The resulting physical response $u(x)$ modeled by solving the discretized Poisson PDE. The $81$ fixed local sensors (square markers) collect the noisy measurements used to infer the unknown source locations (star markers).}}{22}{figure.10}\protected@file@percent }
\newlabel{fig: poisson_setup}{{10}{22}{2D Screened Poisson Equipment Setup. Left: The true multi-source distribution field generated by the ground truth locations. Right: The resulting physical response $u(x)$ modeled by solving the discretized Poisson PDE. The $81$ fixed local sensors (square markers) collect the noisy measurements used to infer the unknown source locations (star markers)}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Marginal Posterior for Source 1 ($\theta _1$) in the Poisson Inverse Problem. The Exact configuration produces tightly bounded, high-fidelity posterior samples. The Neural Network-approximated Stochastic result exhibits structural degradation, validating the necessity of using exact PDE evaluations for calculating the importance weights.}}{22}{figure.11}\protected@file@percent }
\newlabel{fig: poisson_marginals}{{11}{22}{Marginal Posterior for Source 1 ($\theta _1$) in the Poisson Inverse Problem. The Exact configuration produces tightly bounded, high-fidelity posterior samples. The Neural Network-approximated Stochastic result exhibits structural degradation, validating the necessity of using exact PDE evaluations for calculating the importance weights}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Quantum Path Integral Distillation. Comparison of the marginal spatial density between the classical distribution constructed from the empirical training samples and the distilled quantum distribution extracted using Jeffreys Flow.}}{23}{figure.12}\protected@file@percent }
